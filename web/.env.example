# ==========================================
# MEET MINUTES PRO — PORTAL CONFIGURATION
# ==========================================

# Google Gemini API Key (Required)
# Retrieve a free or pay-as-you-go key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Pooled Groq API Keys (Optional)
# Used as the primary engine for speech-to-text (Whisper-Large-v3) and summarization (Llama-3.3-70B).
# If left empty, the server automatically falls back to transcribing and summarizing with Gemini!
# Format: comma-separated list of keys, or individual keys
GROQ_API_KEYS=gsk_key1,gsk_key2
# Alternatively, configure individual keys:
# GROQ_API_KEY_1=gsk_key1
# GROQ_API_KEY_2=gsk_key2

# Advanced Settings
# Fallback model used when Groq keys fail or are empty
LLM_FALLBACK_MODEL=gemini-2.5-flash

# Custom Deployment Portal URL (Optional)
# Used by pack-extension.js to pre-bind your Chrome Extension to your custom server.
# If you deploy to Vercel, this is auto-populated using Vercel's VERCEL_URL env variable.
# PORTAL_URL=https://your-custom-domain.com
